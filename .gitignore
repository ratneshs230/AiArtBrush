# ART-loop .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Next.js build output
.next/
out/

# Backend build output
backend/dist/
backend/logs/
backend/temp/
backend/storage/images/*
!backend/storage/images/.gitkeep

# Shared package build
shared/dist/
shared/lib/

# TypeScript cache
*.tsbuildinfo

# Logs
logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
*.lcov
.nyc_output

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Redis dump file
dump.rdb

# IDE and Editor files
.vscode/settings.json
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Deployment
.vercel
.railway
.netlify

# Testing
test-results/
playwright-report/

# Temporary files
tmp/
temp/

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# AI service cache
replicate-cache/
gemini-cache/

# Bull queue files
.redisState

# Build outputs
build/
dist/

# Local configuration overrides
*local.json
*local.js
*local.ts

# Security files
.secrets
credentials.json
service-account.json

# Backup files
*.backup
*.bak
*.tmp